      "parameters": {
        "jsCode": "// Convert publish_at (Vietnam local time) into the two formats YouTube and\n// Facebook each require.\n// publish_at is written in the sheet as: 2026-08-20 19:00\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  const raw = (r.publish_at || '').toString().trim();\n\n  let publishAtISO = null;\n  let scheduledUnix = null;\n\n  if (raw) {\n    // Pin to the +07:00 offset (Asia/Saigon)\n    const iso = raw.replace(' ', 'T') + ':00+07:00';\n    const d = new Date(iso);\n    if (!isNaN(d.getTime())) {\n      publishAtISO = d.toISOString();          // YouTube: RFC3339 UTC\n      scheduledUnix = Math.floor(d.getTime() / 1000); // Facebook: unix seconds\n    }\n  }\n\n  // Facebook requires the schedule to be at least 10 minutes out.\n  // If it is too close, push it to 15 minutes.\n  const nowUnix = Math.floor(Date.now() / 1000);\n  if (scheduledUnix && scheduledUnix < nowUnix + 600) {\n    scheduledUnix = nowUnix + 900;\n    publishAtISO = new Date(scheduledUnix * 1000).toISOString();\n  }\n\n  // The sheet's `social` column narrows which platforms a row goes to.\n  // Blank or \"all\" posts everywhere; \"yt\"/\"youtube\" and \"fb\"/\"facebook\" restrict to\n  // one. Anything unrecognised falls back to posting on both, so a typo in the sheet\n  // can never silently drop a clip.\n  const social = (r.social || '').toString().toLowerCase().trim();\n  const onlyYT = social === 'yt' || social === 'youtube';\n  const onlyFB = social === 'fb' || social === 'facebook';\n\n  out.push({\n    json: {\n      ...r,\n      publishAtISO,\n      scheduledUnix,\n      hasSchedule: !!scheduledUnix,\n      lang: (r.lang || 'vi').toString().toLowerCase().trim(),\n      social,\n      postYT: !onlyFB,\n      postFB: !onlyYT\n    }\n  });\n}\n\nreturn out;"
      },
