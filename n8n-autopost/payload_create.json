    {
      "parameters": {
        "jsCode": "// n8n drops binary on every HTTP Request hop, so the Reels upload step cannot see\n// the clip \"Download From Drive\" fetched. Re-attach it and pull the exact byte count\n// that rupload.facebook.com requires in its file_size header.\n//\n// Do NOT read the binary content here (getBinaryDataBuffer / base64 decode): under\n// filesystem binary mode + the JS task runner, binary reads inside a Code node throw\n// \"Unknown error\" - this is documented n8n behaviour, not a bug to work around.\n// n8n's own binary metadata already carries the exact size as `.bytes`, no read needed.\nconst src = $('Download From Drive').first();\nconst binary = src.binary;\nconst meta = binary && binary.data;\nif (!meta) {\n  throw new Error('No binary \"data\" on Download From Drive output - check that node ran.');\n}\n\nconst size = Number(meta.bytes);\nif (!Number.isFinite(size) || size <= 0) {\n  throw new Error('binary.data.bytes missing or invalid: ' + JSON.stringify(meta.bytes));\n}\n\nreturn $input.all().map(item => ({ json: { ...item.json, file_size: size }, binary }));"
      },
