# DopplerSecret for n8n application
# Loads environment variables from Doppler for n8n configuration
# Required variables in Doppler:
#   - N8N_ENCRYPTION_KEY: Generate with `openssl rand -hex 16`
#   - DB_POSTGRESDB_HOST: postgresql.shared.svc.cluster.local
#   - DB_POSTGRESDB_PORT: 5432
#   - DB_POSTGRESDB_DATABASE: n8n
#   - DB_POSTGRESDB_USER: n8n
#   - DB_POSTGRESDB_PASSWORD: <your-password>
#   - WEBHOOK_URL: https://n8n.ngocquach.com
apiVersion: secrets.doppler.com/v1alpha1
kind: DopplerSecret
metadata:
  name: n8n-secret-ref
  namespace: external
spec:
  # Reference to the Kubernetes Secret containing Doppler service token
  # This secret must be created manually:
  # kubectl create secret generic doppler-token-n8n \
  #   --namespace external \
  #   --from-literal=serviceToken=dp.st.xxxxx
  tokenSecret:
    name: doppler-token-n8n
    namespace: external
  # The Kubernetes Secret that will be created/updated by Doppler Operator
  # All variables from Doppler will be loaded with their original names
  managedSecret:
    name: n8n-env
    namespace: external
