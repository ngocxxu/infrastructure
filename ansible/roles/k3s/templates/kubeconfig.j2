{#
  Rebuilds the kubeconfig from the parsed remote k3s.yaml.

  k3s ships /etc/rancher/k3s/k3s.yaml with the cluster, user and context
  ALL literally named "default". The old task copied that verbatim (only
  swapping 127.0.0.1 for the host IP), so every playbook run reset a
  locally-renamed context back to "default".

  Naming is done structurally here rather than with regex_replace on the
  raw text: certificate-authority-data and client-*-data are base64, and
  base64 can legitimately contain the substring "default". A regex would
  eventually corrupt a certificate in a way that is painful to debug.
#}
apiVersion: v1
kind: Config
preferences: {}
current-context: {{ k3s_context_name }}

clusters:
  - name: {{ k3s_context_name }}
    cluster:
      certificate-authority-data: {{ _k3s_kubeconfig.clusters[0].cluster['certificate-authority-data'] }}
      server: https://{{ ansible_host }}:6443

users:
  - name: {{ k3s_context_name }}
    user:
      client-certificate-data: {{ _k3s_kubeconfig.users[0].user['client-certificate-data'] }}
      client-key-data: {{ _k3s_kubeconfig.users[0].user['client-key-data'] }}

contexts:
  - name: {{ k3s_context_name }}
    context:
      cluster: {{ k3s_context_name }}
      user: {{ k3s_context_name }}
